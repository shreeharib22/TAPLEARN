# Copy this file to backend/.env for local development.
# Never commit backend/.env or put secrets in frontend environment variables.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Persistent backend database and local file storage.
# In production, mount a persistent writable volume at /var/data.
TAPLEARN_DB_PATH=/var/data/taplearn.db
TAPLEARN_UPLOAD_DIR=/var/data/uploads

# Include the deployed frontend origin, plus localhost origins for local development.
TAPLEARN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://taplearn-flame.vercel.app

# Optional S3-compatible object storage (e.g. Cloudflare R2).
# Leave S3_BUCKET_NAME empty to use TAPLEARN_UPLOAD_DIR instead.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
